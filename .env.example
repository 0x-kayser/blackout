# BLACKOUT API — copy to .env and fill in. Never commit real values (.env is git-ignored).

# --- server ---
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=data/blackout.sqlite
# Comma-separated browser origins allowed for CORS + write routes (Vite dev server by default)
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when serving over HTTPS so the session cookie gets the Secure flag
COOKIE_SECURE=false
# Set to true behind a reverse proxy / PaaS load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false
# Built web app to serve at / (single-origin deployment). Defaults to <repo>/dist when it exists.
# WEB_DIST=/app/dist
# Structured JSON request logs (credentials/cookies are always redacted)
LOG_JSON=true
LOG_LEVEL=info

# --- authentication (optional; guest play always works) ---
# Supabase project URL + publishable/anon key (public by design; served to the browser via /api/config/public).
# The API verifies access tokens locally against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Advertise Google only after enabling the Google provider in the Supabase dashboard.
AUTH_GOOGLE_ENABLED=false
# Email magic links are on whenever Supabase is configured; set false to hide them.
AUTH_EMAIL_ENABLED=true

# --- frontend dev proxy (non-secret) ---
# The web app always calls same-origin /api; in dev Vite proxies it here.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# --- NEAR testnet (optional). Chain mode turns on ONLY when every value below is set. ---
# Generate these with `pnpm chain:bootstrap` using your own funded testnet account; it writes .env.chain.
NEAR_CHAIN_ENABLED=false
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER_TX_BASE=https://testnet.nearblocks.io/txns/
NEAR_RESOURCE_CONTRACT_ID=
NEAR_VAULT_ACCOUNT_ID=
# Vault operator FUNCTION-CALL key: receiver = resource contract; methods = custodial_list/cancel/fill.
NEAR_VAULT_OPERATOR_PRIVATE_KEY=
# Merchant NPC accounts: FUNCTION-CALL keys only (receiver = resource contract, method = npc_transfer)
NEAR_MERCHANT_EMBER_ACCOUNT_ID=
NEAR_MERCHANT_EMBER_PRIVATE_KEY=
NEAR_MERCHANT_LANTERN_ACCOUNT_ID=
NEAR_MERCHANT_LANTERN_PRIVATE_KEY=
NEAR_MERCHANT_HARBOR_ACCOUNT_ID=
NEAR_MERCHANT_HARBOR_PRIVATE_KEY=
# The rival's trades settle in the game ledger only; leave empty unless it gets a real chain leg.
NEAR_RIVAL_ACCOUNT_ID=

# --- one-time bootstrap only (developer machine, NOT the game server) ---
# NEAR_PARENT_ACCOUNT_ID=you.testnet
# NEAR_PARENT_PRIVATE_KEY=ed25519:...
