{
  "name": "blackout",
  "private": true,
  "version": "0.1.0",
  "description": "BLACKOUT \u2014 Every Light Changes the Economy. NEAR Hackathon games track.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @blackout/api --filter @blackout/web dev",
    "dev:api": "pnpm --filter @blackout/api dev",
    "dev:web": "pnpm --filter @blackout/web dev",
    "start": "pnpm --filter @blackout/api start",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @blackout/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "cd contracts/near && cargo test",
    "build:contract": "bash scripts/build-contract.sh",
    "sim:replay": "tsx packages/sim/src/cli.ts",
    "chain:bootstrap": "tsx scripts/near-bootstrap.ts",
    "docs:examples": "tsx scripts/capture-examples.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "chain:economy": "tsx scripts/near-economy-bootstrap.ts",
    "chain:demo": "tsx scripts/near-economy-demo.ts",
    "chain:upgrade": "tsx scripts/near-economy-upgrade.ts",
    "chain:keys": "tsx scripts/near-economy-keys.ts"
  },
  "devDependencies": {
    "@blackout/api": "workspace:*",
    "@blackout/shared": "workspace:*",
    "@blackout/sim": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "jose": "^6.2.15",
    "near-api-js": "^7.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
